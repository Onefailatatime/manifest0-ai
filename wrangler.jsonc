{
  "name": "manifest0-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // wrangler dev would otherwise present local requests as manifest0ai.com, and sign-in would refuse them (src/auth.ts).
  "dev": { "host": "localhost:8787" },

  // manifest0ai.com (and www) = beta landing page at / with the apply form. app.manifest0ai.com = the app.
  // /join and /beta redirect to / here (src/index.ts). If manifest0ai.com/join* is still a route on the
  // manifest0-beta Worker, remove it: routes run before custom domains.
  "routes": [
    { "pattern": "manifest0ai.com", "custom_domain": true },
    { "pattern": "www.manifest0ai.com", "custom_domain": true },
    { "pattern": "app.manifest0ai.com", "custom_domain": true }
  ],

  // Static files served from ./public: landing page at / (index.html), the app at /app/, beta admin at /admin/.
  // "/" and "/index.html" go through the Worker first so app.manifest0ai.com/ can serve the app page.
  // Videos too: static assets ignore Range requests, which iPhone Safari needs to play video (src/index.ts, ranged).
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/", "/index.html", "/img/*.mp4"] },

  // D1 = Cloudflare's SQL database (SQLite). Tables: see migrations/
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "manifest0-db",
      "database_id": "b56bcbf4-26e7-45ff-b3b8-64d2d7f800a3",
      "migrations_dir": "migrations"
    }
  ],

  // R2 = file storage. Label photos and SDS PDFs live here.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "manifest0-files" }],

  // The Agent. Each site visit gets its own VisitAgent instance (a Durable Object).
  "durable_objects": {
    "bindings": [{ "name": "VisitAgent", "class_name": "VisitAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VisitAgent"] }],

  "vars": {
    "MUSE_MODEL": "muse-spark-1.3",
    // Sender address on our domain, verified in Resend.
    "EMAIL_FROM": "Manifest0 AI <reports@manifest0ai.com>"
  }
  // Secrets (not in this file): MODEL_API_KEY, RESEND_API_KEY, BETTER_AUTH_SECRET (signs sessions),
  // ADMIN_EMAILS (comma-separated; they sign in as admins and open /admin/). See src/auth.ts.
  // Locally in .dev.vars; in production in the dashboard (Settings → Variables and Secrets).
  // Without RESEND_API_KEY, emails aren't sent; the report is saved to R2 instead (see the log).
}
