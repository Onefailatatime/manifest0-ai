{
  "name": "manifest0-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Static files (the upload page) served from ./public
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },

  // D1 = Cloudflare's SQL database (SQLite). Our tables: scans, products.
  "d1_databases": [
    { "binding": "DB", "database_name": "manifest0-db", "migrations_dir": "migrations" }
  ],

  // R2 = file storage. Label photos and SDS PDFs live here.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "manifest0-files" }],

  // The Agent. Each site visit gets its own VisitAgent instance (a Durable Object).
  "durable_objects": {
    "bindings": [{ "name": "VisitAgent", "class_name": "VisitAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VisitAgent"] }],

  "vars": {
    "MUSE_MODEL": "muse-spark-1.3",
    // Until the Resend domain is verified, onboarding@resend.dev can only send to the Resend account's own address.
    "EMAIL_FROM": "Manifest Zero <onboarding@resend.dev>"
  }
  // Secrets (not in this file): MODEL_API_KEY, RESEND_API_KEY.
  // Locally in .dev.vars; in production in the dashboard (Settings → Variables and Secrets).
  // Without RESEND_API_KEY, emails aren't sent; the report is saved to R2 instead (see the log).
}
